# Point the example app at your workspace. Copy to `.env`.
#
# EXPO_PUBLIC_* variables are inlined into the bundle by Expo, which is fine
# here: neither value is a secret. The API base and the tenant slug are exactly
# what a real host app ships, and the widget protocol is anonymous by design —
# the only credential is the per-visitor JWT the server mints at runtime.
EXPO_PUBLIC_ELC_API_BASE=https://api.livechattools.com
EXPO_PUBLIC_ELC_TENANT_SLUG=acme
