.expo/

# Generated by `expo prebuild` from app.json, which is the source of truth for
# native config. Committing them freezes that config and churns on every
# prebuild; `scripts/sync-rn-sdk-mirror.sh` excludes them for the same reason.
example/ios/
example/android/

# Local workspace pointer for the example. `.env.example` is the tracked
# template — this one names whichever tenant you are testing against.
example/.env
