{
  "name": "@easylivechat/react-native-ui",
  "version": "0.1.5",
  "description": "Prebuilt, themeable React Native chat UI for EasyLiveChat live customer support: launcher bubble, chat screen, pre-chat form, attachments and CSAT, driven by your widget config.",
  "license": "MIT",
  "homepage": "https://livechattools.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4hmoud/easylivechat-react-native-sdk.git",
    "directory": "packages/easylivechat-react-native-ui"
  },
  "keywords": [
    "chat",
    "live-chat",
    "customer-support",
    "messaging",
    "widget",
    "react-native",
    "expo"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@easylivechat/react-native": "^0.1.2"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.23.0",
    "expo-audio": ">=0.3.0",
    "expo-document-picker": ">=12.0.0",
    "expo-file-system": ">=17.0.0",
    "expo-image": ">=1.13.0",
    "expo-image-picker": ">=15.0.0",
    "expo-linking": ">=6.3.0",
    "expo-secure-store": ">=13.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=18"
  }
}
